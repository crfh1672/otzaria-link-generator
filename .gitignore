# Dependencies
node_modules/

# Build output
dist/
*.otzplugin

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# QA fixtures - regenerate with `node qa/extract-books.mjs` (see qa/README.md)
qa/data/

# Shas commentary link dump (~31MB) - regenerate with
# `node scripts/extract-shas-commentary-links.mjs`. It is only the INPUT to
# scripts/generate-shas-mirror.mjs; the generated src/data/shasMirrorTable.ts is committed,
# so a build does not need this directory.
data/shas-commentary-links/

# Scratch probes / one-off diagnostics
src/utils/_*_probe.ts
qa/*-probe.ts
qa/single-word-dh*

# Profiler output
__prof_now/
*.cpuprofile
